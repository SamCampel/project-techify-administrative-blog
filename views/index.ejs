<%- include('partials/header.ejs') %>
<%- include('partials/homenavbar.ejs') %>

<div class="container">
    <hr>
    <div class="jumbotron">
        <h1 class="display-4">Bem-vindo ao Techify</h1>
        <p class="lead">Leia e publique artigos sobre o mundo da programação</p>
        <hr class="my-4">
    </div>
    <hr>
    <% articles.forEach(article => { %>
        <div class="card">
            <div class="card-header">
                <h2><%= article.title %></h2>
            </div>
            <div class="card-body">
                <a href="/<%= article.slug %>" class="btn btn-warning">Ler artigo</a>
            </div>
        </div>
        <br>
    <% }) %>

    <div class="row">
        <div class="col col-12">
            <a style="float:right" href="/articles/page/2">Next >>></a>
        </div>
        <hr>
    </div>
    <hr>
</div>

<%- include('partials/footer.ejs') %>